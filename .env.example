# ════════════════════════════════════════════════
# NXA-Coin Deployment Config
# Copy this file to .env and fill in as scripts run
# ════════════════════════════════════════════════

# Network: devnet | mainnet-beta | testnet
SOLANA_NETWORK=devnet

# RPC endpoint (default Solana endpoint — works fine for devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Path to deployer keypair (created by script 1)
DEPLOYER_KEYPAIR_PATH=./keys/deployer.json

# Token mint address (filled in automatically after script 3)
NXA_MINT_ADDRESS=

# Token metadata URI (off-chain JSON — points to metadata/nxa-token.json initially)
NXA_METADATA_URI=https://raw.githubusercontent.com/placeholder/nxa-token.json

# Token parameters
NXA_NAME=NXA-Coin
NXA_SYMBOL=NXA
NXA_DECIMALS=9
NXA_TOTAL_SUPPLY=1000000000
